# EMOTION ENGINE · configuración del servidor (nunca se envía al navegador)
# Copia este archivo a .env y completa solo lo que quieras activar.
API_PORT=8787

# --- Intérprete IA (opcional) ---
# AI_PROVIDER=none | anthropic | openai-compatible
AI_PROVIDER=none
# Anthropic (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Proveedor compatible con la API de chat de OpenAI (OpenAI, OpenRouter, Ollama, LM Studio…)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_MIN=10

# --- Generación musical (opcional) ---
# MUSIC_PROVIDER=none | mock | http
#   mock: sintetizador procedural del servidor, SOLO para probar el flujo (no es IA)
#   http: adaptador genérico hacia un servicio externo
MUSIC_PROVIDER=none
MUSIC_API_URL=
MUSIC_API_KEY=
MUSIC_TIMEOUT_MS=120000
MUSIC_MAX_DURATION_SEC=30
MUSIC_DAILY_LIMIT=20
# Coste estimado por segundo generado (USD), solo informativo
MUSIC_COST_PER_SEC_USD=0
